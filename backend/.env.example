# Copy to backend/.env and fill in. Never commit the real .env.
#
# Host only, e.g. https://salescrm.ninjavan.co — the app appends /api/v1 itself.
# NOT the web UI link you click around in (that one has /nv/... after it).
CRM_API_BASE_URL=

# The crm_... key, sent as the X-API-Key header. It IS a CRM user: the app sees exactly
# what that user is allowed to see. If /api/verify reports far fewer rows than expected,
# this user's visibility is the first thing to check (GET /api/whoami).
CRM_API_KEY=  # secret

# Opportunity record URL; "{id}" is replaced with the opportunity id. Used for the
# "Buka CRM" link on each row. Leave blank to hide those links.
CRM_OPPORTUNITY_URL_TEMPLATE=

# Task record URL; "{id}" is replaced with the task id. Used for the clickable Subject
# links in Alex Direction / Hypercare-Strategic / Must Win. Leave blank to hide those.
CRM_TASK_URL_TEMPLATE=

# A task counts as "stale" when its last update is older than this many days.
# Overridable per-request from the UI dropdown; this is just the default.
STALE_DAYS=14

# Timezone all overdue/stale math runs in. Do not change unless the team moves.
APP_TIMEZONE=Asia/Jakarta

# Cap on Opportunity name lookups per sync (1 request each). The rest fill in next sync.
MAX_ENRICH_PER_SYNC=400

# Manager roster (Manager column/filter) has no env var for its data — the "ID-User
# Master" sheet can't be fetched live (org Workspace policy blocks external/link
# sharing), so it's uploaded by hand via POST /api/manager-roster instead. See
# manager_roster.py.
#
# Who is allowed to do that upload, though, IS an env var — comma-separated emails
# checked against X-Forwarded-Email. Empty/unset means nobody passes once SSO is on
# (fail closed), and the check is skipped entirely when there's no SSO header at all
# (local dev).
ROSTER_ADMIN_EMAILS=syachid.kusuma@ninjavan.co
